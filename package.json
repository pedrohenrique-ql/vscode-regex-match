{
  "name": "regex-match",
  "displayName": "Regex Match",
  "description": "Create, test and debug regular expressions in Visual Studio Code",
  "version": "0.7.2",
  "author": {
    "name": "Pedro Henrique Queiroz Lúcio",
    "email": "pedrohenriqueql.dev@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pedrohenrique-ql/vscode-regex-match"
  },
  "publisher": "pedrohenrique-ql",
  "engines": {
    "node": ">=24.13.0 <25.0.0",
    "vscode": "^1.96.0"
  },
  "license": "MIT",
  "categories": [
    "Other",
    "Programming Languages",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "regex",
    "regular expression",
    "regexp",
    "test"
  ],
  "icon": "./assets/icon.png",
  "packageManager": "pnpm@10.30.0",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:regex-match",
    "regex-match.openRegexMatchWindow"
  ],
  "contributes": {
    "languages": [
      {
        "id": "regex-match",
        "aliases": [
          "Regex Match",
          "Regex"
        ],
        "extensions": [
          ".rgx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/rgx-icon.svg",
          "dark": "./assets/rgx-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "regex-match",
        "scopeName": "source.rgx",
        "path": "./syntaxes/regex-match.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "regex-match.openRegexMatchWindow",
        "title": "Regex Match: Open Regex Match Window"
      },
      {
        "command": "regex-match.applyRegexToCode",
        "title": "Regex Match: Apply Regex to Code"
      }
    ],
    "snippets": [
      {
        "language": "regex-match",
        "path": "./snippets/snippets.json",
        "name": "Regex Test Block"
      }
    ],
    "keybindings": [
      {
        "command": "regex-match.openRegexMatchWindow",
        "key": "ctrl+alt+x",
        "mac": "cmd+alt+x"
      },
      {
        "command": "editor.action.insertSnippet",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "editorTextFocus && editorLangId == 'regex-match'",
        "args": {
          "langId": "regex-match",
          "name": "Regex Test Block"
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Regex Match",
      "properties": {
        "regex-match.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the code lens that allows you to test the regex from code editor."
        },
        "regex-match.colorHighlighting": {
          "type": "object",
          "description": "Colors used to highlight the matches and capturing groups.",
          "properties": {
            "match": {
              "type": "string",
              "default": "#FFA50080",
              "format": "color-hex",
              "description": "Color used to highlight the matches."
            },
            "firstGroup": {
              "type": "string",
              "default": "#07925C99",
              "format": "color-hex",
              "description": "Color used to highlight the first group."
            },
            "secondGroup": {
              "type": "string",
              "default": "#3164CACC",
              "format": "color-hex",
              "description": "Color used to highlight the second group."
            },
            "thirdGroup": {
              "type": "string",
              "default": "#6E25B7B2",
              "format": "color-hex",
              "description": "Color used to highlight the third group."
            },
            "fourthGroup": {
              "type": "string",
              "default": "#D339DF99",
              "format": "color-hex",
              "description": "Color used to highlight the fourth group."
            },
            "fifthGroup": {
              "type": "string",
              "default": "#006B6BCC",
              "format": "color-hex",
              "description": "Color used to highlight the fifth group."
            },
            "sixthGroup": {
              "type": "string",
              "default": "#B82F2F99",
              "format": "color-hex",
              "description": "Color used to highlight the sixth group."
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "vscode:package": "pnpm vsce package --no-dependencies",
    "vscode:publish": "pnpm vsce publish --no-dependencies",
    "compile": "pnpm run types:check && tsup",
    "pre:test": "pnpm run compile",
    "test": "vitest",
    "test:vsc": "pnpm pre:test && vscode-test",
    "lint": "eslint --cache --no-error-on-unmatched-pattern --no-warn-ignored --fix",
    "style": "prettier --log-level warn --ignore-unknown --no-error-on-unmatched-pattern --cache",
    "style:check": "pnpm style --check",
    "style:format": "pnpm style --write",
    "types:check": "tsc --noEmit",
    "pre:commit": "lint-staged",
    "pre:push": "concurrently --names style,lint,types 'pnpm style:check .' 'pnpm lint .' 'pnpm types:check'",
    "prepare": "husky"
  },
  "dependencies": {
    "@eslint-community/regexpp": "^4.12.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/tmp": "^0.2.6",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-helpers": "^2.0.2",
    "eslint-plugin-prettier": "^5.5.6",
    "fs-extra": "^11.4.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "mocha": "^11.7.6",
    "prettier": "^3.9.6",
    "prettier-plugin-sh": "^0.19.0",
    "tmp": "^0.2.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "pnpm": {
    "overrides": {
      "jws": "^3.2.3",
      "qs": "^6.14.1",
      "esbuild": "^0.28.1",
      "glob@10.4.5": "^10.5.0",
      "js-yaml": "^4.1.1",
      "lodash": "^4.18.1",
      "vite": "^7.3.5",
      "rollup": "^4.59.0",
      "flatted": "^3.4.2",
      "serialize-javascript": "^7.0.5",
      "undici": "^7.24.0",
      "minimatch@^3.0.0": "^3.1.3",
      "minimatch@^9.0.0": "^9.0.7",
      "minimatch@^10.0.0": "^10.2.3",
      "picomatch@^2.0.0": "^2.3.2",
      "picomatch@^4.0.0": "^4.0.4"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
